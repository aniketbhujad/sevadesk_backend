NODE_ENV=production
PORT=5000

# When hosting backend on EC2 and frontend on Vercel:
# Set FRONTEND_ORIGIN to your Vercel deployment URL (or custom domain)
FRONTEND_ORIGIN=https://sevadesk.vercel.app
# Multiple allowed origins (comma-separated):
ALLOWED_ORIGINS=https://sevadesk.vercel.app,http://localhost:5173

# ==============================================================================
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ==============================================================================
# Paste your Neon PostgreSQL connection string here:
# Example: postgresql://neondb_owner:npg_xxxx@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:replace_with_neon_password@ep-replace-me.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 2. AUTHENTICATION & SECRETS
# ==============================================================================
JWT_SECRET=replace_with_a_long_random_jwt_secret_min_32_characters
COOKIE_SECRET=replace_with_a_long_random_cookie_secret_min_32_characters

# ==============================================================================
# 3. CSC KENDRA DETAILS (Visible on receipts and customer dashboard)
# ==============================================================================
CENTRE_NAME=SevaDesk CSC Kendra
CENTRE_CODE=CSC-2026-IND
CENTRE_PHONE=+91 9876543210
CENTRE_ADDRESS=Shop No. 4, Main Bazar, Opposite Post Office
RECEIPT_FOOTER=Thank you for visiting SevaDesk. Retain this receipt for your reference.
TIMEZONE=Asia/Kolkata

# ==============================================================================
# 4. SMS NOTIFICATIONS (AWS End User Messaging SMS)
# ==============================================================================
# Leave SMS_ENABLED=false while AWS is not configured.
# SevaDesk automatically uses the Mock SMS Provider (logs simulated receipts in Outbox with zero charges).
SMS_ENABLED=false

# (Only needed when you decide to configure AWS in the future)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMS_SENDER_ID=
SMS_ORIGINATION_IDENTITY=
SMS_TEMPLATE="{CENTRE_NAME}: Receipt {RECEIPT_NO}. Service: {SERVICE_NAME}. Total: Rs {TOTAL}. Paid: Rs {PAID_TO_DATE}. Balance: Rs {BALANCE}. Thank you."
